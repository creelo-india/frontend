# API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000
REACT_APP_API_BASE_URL=http://localhost:5000

# Optional: USER role UUID for consumer registration (from backend seed).
# If not set, registration will show "not configured".
# VITE_USER_ROLE_ID=<uuid>
# REACT_APP_USER_ROLE_ID=<uuid>

# Optional: Enable when backend implements GET /api/catalog/vendor-listings (purchasable listings).
# Until then, only master-products (catalog) is used; no prices or Add to cart from API.
# VITE_VENDOR_LISTINGS_ENABLED=true
# REACT_APP_VENDOR_LISTINGS_ENABLED=true
